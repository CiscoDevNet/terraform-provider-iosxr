# IOS-XR Test Environment Configuration
# Copy this file to .env and fill in your actual values

# Global credentials (used as fallback if version-specific credentials are not set)
IOSXR_USERNAME=cisco
IOSXR_PASSWORD=cisco

# Keep connections open between operations instead of reconnecting each time
IOSXR_REUSE_CONNECTION=true
# Number of retries for API calls
IOSXR_RETRIES=3
# Use TLS for the connection
IOSXR_TLS=false
# Verify the target's TLS certificate
# IOSXR_VERIFY_CERTIFICATE=true
# Path to the TLS CA certificate file
# IOSXR_CA_CERTIFICATE=unset
# Path to the TLS certificate file
# IOSXR_CERTIFICATE=unset
# Path to the TLS private key file
# IOSXR_KEY=unset
# gnmi or netconf
IOSXR_PROTOCOL=gnmi
# Netconf lock release timeout in seconds
# IOSXR_LOCK_RELEASE_TIMEOUT=120
# gNMI operation timeout in seconds
# IOSXR_TIMEOUT=30
# Set to false to disable client-side caching
IOSXR_CLIENT_CACHE=true

# 24.4 XRV9K
IOSXR_244_HOST=localhost:57119
# Optional: Override global username
# IOSXR_244_USERNAME=cisco
# Optional: Override global password
# IOSXR_244_PASSWORD=cisco

# 25.4 XRV9K
IOSXR_254_HOST=localhost:57125
# Optional: Override global username
# IOSXR_254_USERNAME=cisco
# Optional: Override global password
# IOSXR_254_PASSWORD=cisco

# 26.2 XRV9K
IOSXR_262_HOST=localhost:57124
# Optional: Override global username
# IOSXR_262_USERNAME=cisco
# Optional: Override global password
# IOSXR_262_PASSWORD=cisco

# Set to 1 to enable debug logging
# DEBUG=0
