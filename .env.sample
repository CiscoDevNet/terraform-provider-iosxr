# IOS-XR Test Environment Configuration
# Copy this file to .env and fill in your actual values

# Global credentials (used as fallback if version-specific credentials are not set)
IOSXR_USERNAME=cisco
IOSXR_PASSWORD=cisco
IOSXR_REUSE_CONNECTION=true  # keep connections open between operations instead of reconnecting each time
IOSXR_RETRIES=3  # number of retries for API calls
IOSXR_TLS=false  # use TLS for the connection
# IOSXR_VERIFY_CERTIFICATE=true  # verify the target's TLS certificate
# IOSXR_CA_CERTIFICATE=unset  # path to the TLS CA certificate file
# IOSXR_CERTIFICATE=unset  # path to the TLS certificate file
# IOSXR_KEY=unset  # path to the TLS private key file
IOSXR_PROTOCOL=gnmi  # or netconf
# IOSXR_LOCK_RELEASE_TIMEOUT=120  # netconf lock release timeout in seconds
IOSXR_CLIENT_CACHE=true  # false to disable client-side caching

# 24.4 XRV9K
IOSXR_244_HOST=localhost:57119
# IOSXR_244_USERNAME=cisco  # Optional: Override global username
# IOSXR_244_PASSWORD=cisco  # Optional: Override global password

# 25.4 XRV9K
IOSXR_254_HOST=localhost:57125
# IOSXR_254_USERNAME=cisco  # Optional: Override global username
# IOSXR_254_PASSWORD=cisco  # Optional: Override global password

# 26.2 XRV9K
IOSXR_262_HOST=localhost:57127
# IOSXR_262_USERNAME=cisco  # Optional: Override global username
# IOSXR_262_PASSWORD=cisco  # Optional: Override global password

# Set to 1 to enable debug logging
# DEBUG=0
